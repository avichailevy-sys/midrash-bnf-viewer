{"i":"IE51781289_P000248_FL51781550","p":248,"f":"122v","u":"https://gallica.bnf.fr/iiif/ark:/12148/btv1b10541990r/f249","w":2649,"h":3648,"l":[[476,271,1537,144,1,1.0,"ומגילתו עפה .. הכינם בחיטמים .."],[557,411,1443,117,1,0.96,"נעור בני חוקה . . בריאה דזזקין ."],[573,514,1407,134,1,0.92,"לחי אין בדיק . . ונאכל לעויים ."],[543,627,1473,145,1,0.98,"יד לכל ענד תיפן .. בסביבות הדופן .."],[565,762,1413,121,1,0.98,"והשמר פן .. תהיו יושמים ."],[543,871,1469,132,1,0.94,"אין ידפונות . הליו שלש חונות .."],[504,986,1470,138,1,0.98,"ועל שריול חונות . . שתים נתחומים ."],[617,1106,1382,130,1,0.98,"עצוניתיו תחת .. בחשבון לקחת ."],[474,1218,1506,129,1,0.94,"יום חסר יוחת .. שלשה הרשורים ."],[599,1331,1399,128,1,0.92,"קהילת מורשה .. זסר כי החכשה ."],[525,1436,1438,133,1,0.99,"ויש בה ששה . . קחיות בת דמים .."],[705,1548,1283,139,1,0.97,"בה חסרה תויעין . . להי' ליו רעה .."],[654,1661,1304,147,1,0.99,"והשליכה חועה .. לכלב החומים .."],[593,1791,1411,148,1,0.97,"בנוף וייום נקם .. טריפ הייו חלקם ."],[517,1902,1435,141,1,0.99,"ואכלו את חקם .. בפיהם מולמים .."],[565,2042,1423,130,1,1.0,"ריזה בשתי בועות . סויזכות הנוגעות .."],[525,2166,1430,141,1,0.91,"יחדץ הם נובעות . עשו לי לטעויים ."],[699,2282,1296,139,1,0.97,"יון לבדנה קמה . . ותחורי' המה ."],[638,2397,1315,136,1,0.99,"והיווו תטמיו . . דבריו קיימים .."],[662,2521,1322,140,1,0.95,"נשולי הרייה .. רקפת חין נריוה"],[659,2642,1284,129,1,0.9,"והחח שיעיוה .. בפחם פחמים ."],[763,2758,1218,130,1,0.98,"ריוויה לטרף . . תיפן לה שרף ."],[602,2855,1327,146,1,0.97,"ויוכלם ישרף . . וליו ייריך ירים"],[624,2982,1346,139,1,0.97,"היחניו באוור . . ויביתתיו מאומה ."],[660,3098,1265,150,1,0.97,"ובהם מלחמה .. גיזוזנים נלחמים"]]}