{"i":"IE52825345_P000357_FL52825737","p":357,"f":"175r","u":"https://gallica.bnf.fr/iiif/ark:/12148/btv1b105406692/f358","w":1737,"h":2255,"l":[[496,190,1038,123,1,0.97,"ומום בולא יקרב : להקריב שי נערב ."],[482,309,1050,108,1,0.95,"בגבן או גרב . ופסחים או עורים .."],[487,402,1042,115,1,0.99,"ומיד בן נכר . לא תקריב אשכר ."],[505,506,1020,106,1,0.99,"ולא יעבוד איכר . בבכורי שורים .."],[495,591,1027,126,1,0.99,"ולא תעלה לרצון . בכל מקום חיצון"],[474,695,1047,119,1,1.0,"ולא תגוז בכור צאן . במשקה העדרים .."],[505,796,1012,113,1,0.97,"ולא תמיר בהמה . מקודשת התומה ."],[501,890,1014,108,1,0.98,"ולא יאכלו תרומה . טמאים עם זרים .."],[520,988,988,115,1,0.97,"ולא הביא למנה . מחיר כלב וזונה."],[487,1081,1018,116,1,0.9,"ולא תתן לבונה במנחת השערים :"],[525,1187,975,114,1,0.98,"ולא תקריב למשחה . בשמן המשחה"],[476,1288,1025,110,1,0.98,"ולא תשים קדחה . ושרט בבשרים .."],[553,1391,945,112,1,0.93,"קטרת לא תרקה : ועיניך תפקח ."],[468,1482,1023,117,1,0.9,"וכופר לא תקח . לרוצחי מסתרים ."],[550,1589,943,117,1,1.0,"שמור פן תנשה : דבר ויד הנשה"]]}