{"i":"IE55032939_P000043_FL55032983","p":43,"f":"17r","u":"https://gallica.bnf.fr/iiif/ark:/12148/btv1b105493780/f44","w":1664,"h":2360,"l":[[364,246,1050,102,1,0.98,"רה אשר גאה גאה : באופני מרכבה ."],[312,336,944,98,1,0.98,"ורואה כל ולא נראה . אל דבול מרבבה :"],[333,430,920,90,1,0.99,"סגלתך הנלאה . כי צרה מעציבה :"],[330,516,927,100,1,0.98,"פתחים משתאה .: ובית קדש נצבה"],[621,603,468,73,1,0.92,"בערב היאא :"],[342,673,1080,101,1,0.93,"ואנחנו לא נדע : מה נדבר ומה נעשה ."],[375,765,999,84,1,0.95,"כי כלו ואפסו : אנשי חסד ומעשה ."],[361,847,1019,89,1,0.99,"ואין לנו עזרה : ולא מסתור ומחסה :"],[350,929,1013,91,1,0.98,"וולתך אב רחמן . על כל ראש מתנשא"],[381,1022,970,91,1,0.98,"אם רבו פשעינו . למענך אלאי עשה ."],[339,1118,1008,84,1,0.97,"ותבוא אהבת הורים : ופשע בנים תכסה ."],[338,1207,1004,81,1,1.0,"צדקת אב המון גוים : וזכות נעקד כשה"],[490,1288,846,82,1,1.0,"ותם יושב אוהלים : החקוק בכסא"],[418,1363,910,89,1,0.96,"אעבתי צרתי . בשצף קצף תמסה :"],[419,1447,921,89,1,1.0,"האומרה בלבבה . אמלאה החורבה"],[443,1531,962,96,1,0.9,"סובל הכל בבורך .: ובזרוע הצדקה :"],[531,1621,793,83,1,0.99,"פתחיך דפקנו : מבכי ואנקה :"],[499,1700,818,78,1,0.93,"כי כל אכולינו : הקיפה הזעקה :"],[443,1772,872,97,1,0.9,"וכי מלאו מתנינו . חלחלה ומועקה :"],[449,1859,866,99,1,0.96,"ונחלתנו נהפכה : ולאחרים ניתקה .."]]}